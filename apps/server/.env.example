# Render supplies PORT automatically. Locally the server defaults to 2567.
PORT=2567

# Comma-separated browser origins. Set this to the deployed static site's origin.
CLIENT_ORIGIN=http://localhost:5173

# Optional room timing overrides (milliseconds).
AUTO_MOVE_DELAY_MS=1000
TURN_TIMEOUT_MS=30000
RECONNECT_WINDOW_MS=60000
NEXT_ROUND_DELAY_MS=5000
GAME_OVER_LINGER_MS=60000
